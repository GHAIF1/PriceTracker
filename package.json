{
  "name": "galaxus-price-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Watches a Galaxus product page and emails you when the price drops below your threshold.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "once": "node --env-file-if-exists=.env src/index.js --once",
    "test-email": "node --env-file-if-exists=.env src/index.js --test-email",
    "test": "node --test"
  },
  "dependencies": {
    "nodemailer": "^7.0.0",
    "playwright-core": "^1.55.0"
  }
}
